# Public URL of the live site, used for the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Email delivery for the enquiry form, sent with Nodemailer over SMTP.
# Leave SMTP_USER / SMTP_PASS empty to hand enquiries to WhatsApp instead.
# For Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS
# (not your normal Gmail password).
SMTP_USER=binladinconstructions@gmail.com
SMTP_PASS=
# Optional. Defaults are Gmail: smtp.gmail.com on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional. Where enquiries are delivered; defaults to SMTP_USER.
ENQUIRY_TO_EMAIL=binladinconstructions@gmail.com
