# Public URL of the live site, used for the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Email delivery for the enquiry form (https://resend.com).
# Leave these empty to hand enquiries to WhatsApp instead.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=binladinconstructions@gmail.com
# Must be an address on a domain verified in Resend. Without a verified domain,
# Resend only delivers from onboarding@resend.dev to your own account email.
ENQUIRY_FROM_EMAIL="BIN LADIN Website <enquiries@example.com>"
